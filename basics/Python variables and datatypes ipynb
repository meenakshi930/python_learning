     "name": "stdout",
     "output_type": "stream",
     "text": [
      "No value assigned\n"
     ]
    }
   ],
   "source": [
    "empty_value = None\n",
    "\n",
    "if empty_value is None:\n",
    "    print(\"No value assigned\")"
   ]
  },
