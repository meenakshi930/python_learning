    "d=[1,2]\n",
    "print(type(d))\n",
    "e=(1,2)\n",
    "print(type(e))\n",
    "f={'name: john'}\n",
    "print(type(f))\n",
    "g=True\n",
    "print(type(g))\n",
    "h={'name': 'john','age':20,'city': 'agra'}\n",
    "print(type(h))"
   ]
