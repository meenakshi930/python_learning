   "source": [
    "# Checking Variable Types\n",
    "Use type() or isinstance() to check variable types:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "a763ad3f-6835-474c-a118-30f40539e55b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "<class 'int'>\n",
      "<class 'float'>\n",
      "<class 'str'>\n",
      "<class 'list'>\n",
      "<class 'tuple'>\n",
      "<class 'set'>\n",
      "<class 'bool'>\n",
      "<class 'dict'>\n"
     ]
    }
   ],
   "source": [
    "a=5\n",
    "print(type(a))\n",
    "b=2.4\n",
