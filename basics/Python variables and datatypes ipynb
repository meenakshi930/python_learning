     "name": "stdout",
     "output_type": "stream",
     "text": [
      "248.71940000000004\n"
     ]
    }
   ],
   "source": [
    "radius=8.9\n",
    "pi=3.14\n",
    "area=pi*radius*radius\n",
    "print(area)"
   ]
